 "lookup": {
  "order": [
   "kinds[kind].statuses[status]",
   "any[status]",
   "legacy[status]",
   "fallback"
  ],
  "normalize": "Trim and lowercase the status string. Do not fold hyphens and underscores: the dictionary uses both.",
  "label": "The pill label is the status string with hyphens and underscores shown as spaces, uppercased by CSS.",
  "inputs_forbidden": "Priority, severity, record type and checkout state are never inputs to the role lookup."
 },
 "fallback": {
  "role": "unknown",
  "rule": "Any string not found renders as the unknown role: dotted outline, diamond glyph, label verbatim. No code change is needed for it to be readable; adding it to this file gives it a role."
 },
