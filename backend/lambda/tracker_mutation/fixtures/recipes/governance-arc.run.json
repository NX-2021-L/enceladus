{
 "recipe": {
  "recipe_id": "DVP-REC-001",
  "name": "governance-arc",
  "version": "1.1.0",
  "content_hash": "sha256:da640cc49f2c631f8394dc3250b308149251342cbcb3bffe6611e226d4effb80",
  "definition": {
   "description": "Create a no_code task, set its components and check it out, then walk the code, acceptance and release gates to closed. Every gate is a human decision; the runner makes no agent calls of its own beyond the governed tracker/checkout writes. v1.1.0 replaces 1.0.0, whose committed step could never succeed (in-progress allows only coding-complete, and no_code has no committed state).",
   "execution": "deterministic",
   "tools": [
    "checkout.advance",
    "checkout.task",
    "tracker.create",
    "tracker.set",
    "tracker.set_acceptance_evidence"
   ],
   "surfaces": [
    "enceladus"
   ],
   "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "project_id",
     "title",
     "components",
     "acceptance_criteria"
    ],
    "properties": {
     "project_id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "components": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "acceptance_criteria": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "maxItems": 1
     }
    }
   },
   "outputs": {
    "from": {
     "record_id": "$create.record_id"
    },
    "schema": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "record_id"
     ],
     "properties": {
      "record_id": {
       "type": "string"
      }
     }
    }
   },
   "steps": [
    {
     "id": "create",
     "action": "tracker.create",
     "on_error": "abort",
     "arguments": {
      "project_id": "$inputs.project_id",
      "record_type": "task",
      "title": "$inputs.title",
      "transition_type": "no_code",
      "acceptance_criteria": "$inputs.acceptance_criteria"
     }
    },
    {
     "id": "set_components",
     "action": "tracker.set",
     "on_error": "abort",
     "arguments": {
      "record_id": "$create.record_id",
      "field": "components",
      "value": "$inputs.components"
     }
    },
    {
     "id": "checkout",
     "action": "checkout.task",
     "on_error": "abort",
     "arguments": {
      "record_id": "$create.record_id",
      "active_agent_session_id": "$run.started_by"
     }
    },
    {
     "id": "code_gate",
     "gate": "human",
     "prompt": "The work is done. Approve to mark the task coding-complete.",
     "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
       "note": {
        "type": "string"
       }
      }
     },
     "on_reject": "cancelled",
     "on_expire": "expired",
     "timeout": {
      "seconds": 86400
     }
    },
    {
     "id": "coding_complete",
     "action": "checkout.advance",
     "on_error": "abort",
     "arguments": {
      "record_id": "$create.record_id",
      "provider": "$run.started_by",
      "target_status": "coding-complete"
     }
    },
    {
     "id": "acceptance_gate",
     "gate": "human",
     "prompt": "Accept the work against its acceptance criterion and give the evidence.",
     "sensitive": true,
     "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "evidence"
      ],
      "properties": {
       "evidence": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "on_reject": "failed",
     "on_expire": "expired",
     "timeout": {
      "seconds": 86400
     }
    },
    {
     "id": "accept_ac",
     "action": "tracker.set_acceptance_evidence",
     "on_error": "abort",
     "arguments": {
      "record_id": "$create.record_id",
      "criterion_index": 0,
      "evidence": "$acceptance_gate.inputs.evidence",
      "evidence_acceptance": true,
      "provider": "$run.started_by"
     }
    },
    {
     "id": "deploy_gate",
     "gate": "human",
     "prompt": "Approve closing the task (no_code: nothing to deploy).",
     "sensitive": true,
     "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
       "note": {
        "type": "string"
       }
      }
     },
     "on_reject": "failed",
     "on_expire": "expired",
     "timeout": {
      "seconds": 86400
     }
    },
    {
     "id": "close",
     "action": "checkout.advance",
     "on_error": "abort",
     "arguments": {
      "record_id": "$create.record_id",
      "provider": "$run.started_by",
      "target_status": "closed",
      "transition_evidence": {
       "no_code_evidence": "$acceptance_gate.inputs.evidence"
      }
     }
    }
   ]
  }
 },
